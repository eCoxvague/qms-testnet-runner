{
  "name": "qms-testnet-runner",
  "version": "1.0.0",
  "private": true,
  "description": "One-command QMS testnet runner with local encrypted wallet setup, QWAP swaps and liquidity, and QUBO verification.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/eCoxvague/qms-testnet-runner.git" },
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node scripts/start.mjs",
    "streak": "node scripts/start.mjs --streak",
    "streak:prepare": "node scripts/start.mjs --streak --prepare",
    "streak:status": "node scripts/run-streak.mjs --status",
    "streak:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-streak-task.ps1",
    "streak:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/remove-streak-task.ps1",
    "daily": "node scripts/start.mjs --daily",
    "daily:prepare": "node scripts/start.mjs --daily --prepare",
    "daily:status": "node scripts/run-daily.mjs --status",
    "daily:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-daily-task.ps1",
    "daily:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/remove-daily-task.ps1",
    "all": "node scripts/run-all.mjs --broadcast",
    "qms": "node scripts/qms.mjs",
    "status": "node scripts/qms.mjs status",
    "compile": "node scripts/qms.mjs compile",
    "smoke": "node scripts/rpc-smoke.mjs",
    "test": "node --test",
    "security:check": "node scripts/security-check.mjs",
    "key:import": "node scripts/import-key.mjs"
  },
  "dependencies": { "ethers": "6.17.0", "solc": "0.8.37" },
  "overrides": { "solc": { "tmp": "0.2.7" } }
}
